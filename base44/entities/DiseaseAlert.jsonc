{
  "name": "DiseaseAlert",
  "type": "object",
  "properties": {
    "disease": {
      "type": "string"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "Disease",
        "Pest"
      ],
      "default": "Disease"
    },
    "location": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "Low",
        "Moderate",
        "High",
        "Severe"
      ],
      "default": "Moderate"
    },
    "crop": {
      "type": "string"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "recommended_action": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}