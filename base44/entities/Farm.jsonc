{
  "name": "Farm",
  "type": "object",
  "properties": {
    "location": {
      "type": "string",
      "description": "Village/area location"
    },
    "state": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "primary_crop": {
      "type": "string"
    },
    "farm_size": {
      "type": "number"
    },
    "farm_size_unit": {
      "type": "string",
      "enum": [
        "Acres",
        "Hectares",
        "Bigha",
        "Cents"
      ],
      "default": "Acres"
    },
    "language": {
      "type": "string",
      "enum": [
        "English",
        "Malayalam",
        "Hindi",
        "Tamil"
      ],
      "default": "English"
    },
    "phone": {
      "type": "string"
    },
    "planting_date": {
      "type": "string",
      "format": "date"
    },
    "variety": {
      "type": "string"
    }
  }
}