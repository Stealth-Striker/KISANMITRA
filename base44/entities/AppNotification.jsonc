{
  "name": "AppNotification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "harvest",
        "disease",
        "market",
        "diagnosis"
      ]
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  }
}